---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';
---
<BaseLayout
  title="Contact AM Electricals . Kolkata Factory & Sales"
  description="Contact AM Electricals in Kolkata. Phone, WhatsApp, email and factory address. Quotes within one business day."
>
  <section class="container-x pt-10 pb-16 md:pb-24">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
    <div class="grid gap-10 lg:grid-cols-12 items-start pt-2">
      <div class="lg:col-span-7 fade-up">
        <div class="meta text-ink-500 mb-5">Talk to the founder</div>
        <h1 class="tracking-[-0.045em] mb-5 max-w-[16ch]">Fastest reply over WhatsApp.</h1>
        <p class="text-[1.0625rem] text-ink-600 leading-relaxed max-w-[52ch]">
          Quotes within one business day. Same-week site visits across West Bengal, Jharkhand, Odisha and the Northeast.
        </p>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 max-w-lg">
          <a href={`tel:${site.phone}`} class="card card-interactive p-5 no-underline group">
            <div class="meta text-ink-500 mb-1">Phone</div>
            <div class="font-mono text-[15px] text-ink-900 group-hover:text-signal-600">{site.phone}</div>
          </a>
          <a href={site.social.whatsapp} target="_blank" rel="noopener" class="card card-interactive p-5 no-underline group">
            <div class="meta text-ink-500 mb-1">WhatsApp</div>
            <div class="font-mono text-[15px] text-emerald-600">Click to chat</div>
          </a>
          <a href={`mailto:${site.email}`} class="card card-interactive p-5 no-underline sm:col-span-2">
            <div class="meta text-ink-500 mb-1">Email</div>
            <div class="font-mono text-[14px] text-ink-900 break-all">{site.email}</div>
          </a>
        </div>

        <div class="mt-10 max-w-lg">
          <div class="meta text-ink-500 mb-3">Factory address</div>
          <address class="not-italic font-mono text-[14.5px] text-ink-900 leading-relaxed">
            {site.address.street}<br />{site.address.city} {site.address.postcode}<br />{site.address.state}, {site.address.country}
          </address>
        </div>
      </div>

      <div class="lg:col-span-5 fade-up" style="transition-delay: 100ms;">
        <div class="card overflow-hidden">
          <div class="aspect-[4/5] bg-ink-100">
            <iframe
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="AM Electricals Kolkata factory location"
              class="w-full h-full border-0"
              src={`https://www.google.com/maps?q=${encodeURIComponent(`${site.address.street}, ${site.address.city} ${site.address.postcode}`)}&output=embed`}
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ink-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-40 pointer-events-none"></div>
    <div class="container-x py-20 md:py-24 relative grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6 fade-up">
        <div class="meta text-signal-300 mb-4">Send a message</div>
        <h2 class="text-white tracking-[-0.03em] mb-6 max-w-[14ch]">Tell us the spec.</h2>
        <p class="text-ink-300 text-[1.0625rem] leading-relaxed max-w-[42ch]">
          Share SLD, load list, kVA rating and site location. Reply within one business day.
        </p>
      </div>
      <div class="lg:col-span-6 lg:pl-4 fade-up" style="transition-delay: 100ms;">
        <LeadForm subject="Contact page message" dark />
      </div>
    </div>
  </section>
</BaseLayout>
