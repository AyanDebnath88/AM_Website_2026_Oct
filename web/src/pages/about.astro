---
import BaseLayout from '../layouts/BaseLayout.astro';
import CertBadges from '../components/CertBadges.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';
---
<BaseLayout
  title="About AM Electricals . 34 Years Building Panels in Kolkata"
  description="Founded 1991 in Kolkata by Ajit Debnath. 5000 sqft factory, 10 to 20 engineers, CPRI + ISO certified. Control panel manufacturer for APFC, MCC, PCC, AMF, DG sync, PLC."
>
  <section class="container-x pt-10 pb-16 md:pb-24">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
    <div class="grid gap-10 lg:grid-cols-12 items-start pt-2">
      <div class="lg:col-span-7 fade-up">
        <div class="meta text-ink-500 mb-5">Established 1991</div>
        <h1 class="tracking-[-0.045em] mb-6 max-w-[16ch]">Founder-led since 1991.</h1>
        <p class="text-[1.125rem] text-ink-600 leading-relaxed max-w-[54ch]">
          AM Electricals was founded in Kolkata by Ajit Debnath in 1991 to build control panels for Bengal's growing industrial base. 34 years later we still make what we sell, from our own 5,000 sqft factory on Kamardanga Road.
        </p>
      </div>
      <div class="lg:col-span-5 fade-up" style="transition-delay: 100ms;">
        <div class="card overflow-hidden">
          <div class="aspect-[4/5] bg-ink-100 relative">
            <img src="/images/factory/panel-testing.jpg" alt="AM Electricals engineer testing a finished control panel before dispatch, Kolkata workshop" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-950/60 to-transparent"></div>
            <div class="absolute left-5 bottom-5 right-5">
              <div class="meta text-signal-300 mb-1">Kamardanga Road</div>
              <div class="text-white text-lg font-medium">Kolkata, since 1991</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ink-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-40 pointer-events-none"></div>
    <div class="container-x py-16 md:py-20 relative">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { k: `${site.yearsInBusiness}+`, v: 'years in business' },
          { k: '5,000', s: 'sqft', v: 'Kolkata factory' },
          { k: '13', v: 'panel families' },
          { k: '10-20', v: 'people on the floor' },
        ].map((s, i) => (
          <div class="card-dark p-6 fade-up" style={`transition-delay: ${i*70}ms;`}>
            <div class="text-4xl font-medium tracking-tight text-white mb-1">{s.k} {s.s && <span class="text-signal-300 text-lg font-mono">{s.s}</span>}</div>
            <div class="meta text-ink-400">{s.v}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24 grid gap-12 md:grid-cols-2">
    <div class="fade-up">
      <div class="meta text-ink-500 mb-4">The workshop</div>
      <h2 class="tracking-[-0.03em] mb-4">Made where it's sold.</h2>
      <p class="text-[1.0625rem] text-ink-600 leading-relaxed">
        5,000 sqft permanent factory in Kolkata with 10 to 20 electrical engineers, draughtsmen, panel wiremen and test technicians. Every panel is built, wired, tested and FAT-signed here before dispatch.
      </p>
      <p class="text-[1.0625rem] text-ink-600 leading-relaxed mt-4">
        CPRI 6000A type-tested designs. ISO 9001:2008 quality process. IS 8623 / IEC 61439-2 as standard.
      </p>
      <div class="mt-6"><CertBadges /></div>
    </div>
    <div class="fade-up" style="transition-delay: 100ms;">
      <div class="meta text-ink-500 mb-4">The founder</div>
      <h2 class="tracking-[-0.03em] mb-4">Ajit Debnath.</h2>
      <p class="text-[1.0625rem] text-ink-600 leading-relaxed">
        Ajit started AM Electricals as a one-man workshop in 1991. Today he still reviews every non-standard job, every DG-sync SLD, every PLC panel wiring drawing. When an escalation lands, it lands on his phone.
      </p>
      <p class="text-[1.0625rem] text-ink-600 leading-relaxed mt-4">
        Three decades of returning customers who don't need to explain their site twice.
      </p>
    </div>
  </section>

  <section class="bg-surface-muted border-y border-border-subtle py-20 md:py-24">
    <div class="container-x max-w-4xl">
      <div class="meta text-ink-500 mb-4">Registered details</div>
      <h2 class="tracking-[-0.03em] mb-10">On paper.</h2>
      <dl class="grid gap-6 sm:grid-cols-2">
        {[
          {k: 'Founded', v: `${site.established}`},
          {k: 'Founder / CEO', v: site.founder},
          {k: 'Legal status', v: 'Proprietorship Firm'},
          {k: 'Business', v: 'Manufacturer, Supplier, Service Provider'},
          {k: 'Sector', v: 'Control Panels and Boards'},
          {k: 'Factory address', v: `${site.address.street}, ${site.address.city} ${site.address.postcode}`},
          {k: 'Phone', v: site.phone},
          {k: 'Email', v: site.email},
        ].map(item => (
          <div>
            <dt class="meta mb-1">{item.k}</dt>
            <dd class="text-[15px] font-mono text-ink-900">{item.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="meta text-ink-500 mb-4">Proof, not claims</div>
    <h2 class="tracking-[-0.03em] mb-10 max-w-[20ch]">Certifications on file.</h2>
    <div class="grid gap-6 sm:grid-cols-2 max-w-3xl">
      <a href="/images/certificates/cpri-test-report.jpg" target="_blank" rel="noopener" class="card-interactive overflow-hidden no-underline">
        <div class="aspect-[5/7] bg-ink-100 relative">
          <img src="/images/certificates/cpri-test-report.jpg" alt="CPRI short-circuit withstand test report for AM Electricals MCC panel, IS 8623" loading="lazy" class="absolute inset-0 w-full h-full object-cover object-top" />
        </div>
        <div class="p-4">
          <div class="text-[14px] font-medium text-ink-900">CPRI test report</div>
          <div class="meta text-ink-500 mt-0.5">Short-circuit withstand, IS 8623 · click to view</div>
        </div>
      </a>
      <a href="/images/certificates/msme-registration.jpg" target="_blank" rel="noopener" class="card-interactive overflow-hidden no-underline">
        <div class="aspect-[5/7] bg-ink-100 relative">
          <img src="/images/certificates/msme-registration.jpg" alt="MSME Entrepreneurs Memorandum registration for AM Electricals, filed 1991" loading="lazy" class="absolute inset-0 w-full h-full object-cover object-top" />
        </div>
        <div class="p-4">
          <div class="text-[14px] font-medium text-ink-900">MSME registration</div>
          <div class="meta text-ink-500 mt-0.5">Entrepreneurs Memorandum, filed 1991 · click to view</div>
        </div>
      </a>
    </div>
    <p class="meta text-ink-400 mt-6">ISO 9001:2008 certificate and full CPRI test series available on request.</p>
  </section>
</BaseLayout>
