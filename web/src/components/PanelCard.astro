---
interface Props {
  slug: string;
  name: string;
  tagline: string;
  image?: string;
  variant?: 'default' | 'wide' | 'compact';
  index?: number;
}
const { slug, name, tagline, image, variant = 'default', index } = Astro.props;
const imgSeed = slug;
const imgSrc = image && image.length > 0 ? image : `https://picsum.photos/seed/am-${imgSeed}/900/700`;
const aspect = variant === 'wide' ? 'aspect-[16/10]' : variant === 'compact' ? 'aspect-[4/3]' : 'aspect-[4/3]';
---
<a
  href={`/panels/${slug}/`}
  class="fade-up group card card-interactive block no-underline text-ink-900 h-full overflow-hidden"
>
  <div class={`${aspect} bg-ink-100 relative overflow-hidden`}>
    <img
      src={imgSrc}
      alt={name}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.03]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink-950/25 via-transparent to-transparent"></div>
    {typeof index === 'number' && (
      <span class="absolute top-3 left-3 meta text-white/95 bg-ink-950/45 backdrop-blur-md px-2 py-1 rounded-md text-[10px]">
        {String(index).padStart(2, '0')} / 13
      </span>
    )}
  </div>
  <div class="p-5 flex-1 flex flex-col">
    <h3 class="text-[17px] font-medium tracking-tight mb-1.5 leading-snug">{name}</h3>
    <p class="text-[13.5px] text-ink-500 leading-relaxed">{tagline}</p>
    <div class="mt-5 pt-4 border-t border-border-subtle flex items-center justify-between">
      <span class="meta">Full specs</span>
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-ink-100 text-ink-800 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:bg-signal-500 group-hover:text-white">
        <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M3 6h6M6 3l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
  </div>
</a>
