---
interface Props {
  images: string[];
  panelName: string;
}
const { images, panelName } = Astro.props;
---
{images && images.length > 0 && (
  <div class="grid gap-3 grid-cols-2 sm:grid-cols-3 md:grid-cols-4">
    {images.map((src, i) => (
      <a
        href={src}
        target="_blank"
        rel="noopener"
        class="fade-up group card no-underline block overflow-hidden aspect-square bg-ink-100"
        aria-label={`View larger ${panelName} photo ${i+1}`}
      >
        <img
          src={src}
          alt={`${panelName} — view ${i+1}`}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.06]"
        />
      </a>
    ))}
  </div>
)}
