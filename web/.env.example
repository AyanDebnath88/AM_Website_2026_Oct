# AM Electricals . env vars (set in Cloudflare Pages project settings)

# Lead form submissions go to a Google Form (config in web/src/data/site.ts).
# No env var needed . the Form action URL + entry IDs are not secret.

# Plausible analytics domain (privacy-friendly, GDPR-safe)
# Configure a site at https://plausible.io/sites -> Add site
# Value should match the production domain, e.g. amelectricals.co.in
PUBLIC_PLAUSIBLE_DOMAIN=amelectricals.co.in

# Google Search Console verification token
# Search Console -> Add property -> HTML tag method -> copy `content` value only
PUBLIC_GSC_VERIFY=

# Bing Webmaster verification token
# Bing Webmaster -> Add site -> Meta tag -> copy `content` value only
PUBLIC_BING_VERIFY=
